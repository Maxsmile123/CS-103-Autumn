// Решите поставленную задачу в формате четвёрок

// головка на пустой клетке слева от первого числа n
// шагаем вправо на первую цифру n

q1, ,>,q2

// идём по n вправо до пробела, за ним начинается второе число w

q2,0,>,q2
q2,1,>,q2
q2, ,>,q3

// копируем w вправо через пробел (r - копия, будущий результат)
// q3 ищет первую непомеченную цифру w и помечает её: a - 0, b - 1
// q4 несёт 0, q5 несёт 1

q3,a,>,q3
q3,b,>,q3
q3,0,a,q4
q3,1,b,q5

// цифра идёт через остаток w (q6, q9) и через копию r (q7, q10)
// и дописывается в конец копии

q4,a,>,q6
q6,0,>,q6
q6,1,>,q6
q6, ,>,q7
q7,0,>,q7
q7,1,>,q7
q7, ,0,q8

q5,b,>,q9
q9,0,>,q9
q9,1,>,q9
q9, ,>,q10
q10,0,>,q10
q10,1,>,q10
q10, ,1,q8

// возвращаемся через копию и остаток w до последней метки

q8,0,<,q8
q8,1,<,q8
q8, ,<,q11
q11,0,<,q11
q11,1,<,q11
q11,a,>,q3
q11,b,>,q3

// w скопировано, идём влево и возвращаем цифры w (a - 0, b - 1)

q3, ,<,q12
q12,a,0,q13
q12,b,1,q13
q13,0,<,q12
q13,1,<,q12
q12, ,<,q14

// q14 ищет в n следующую непомеченную цифру (справа налево) и помечает её
// каждая помеченная цифра n - это один сдвиг r

q14,a,<,q14
q14,b,<,q14
q14,0,a,q15
q14,1,b,q15

// идём вправо через n (q16) и w (q17) в конец r (q18), встаём на последнюю цифру r

q15,a,>,q16
q15,b,>,q16
q16,a,>,q16
q16,b,>,q16
q16, ,>,q17
q17,0,>,q17
q17,1,>,q17
q17, ,>,q18
q18,0,>,q18
q18,1,>,q18
q18, ,<,q19

// сдвиг r влево на 1 разряд, идём справа налево
// q19 несёт 0, q20 несёт 1; в конец r встаёт 0, старший бит выпадает

q19,0,<,q19
q20,1,<,q20
q19,1,0,q21
q21,0,<,q20
q20,0,1,q22
q22,1,<,q19
q19, ,<,q23
q20, ,<,q23

// возвращаемся через w к концу n и ищем следующую цифру n

q23,0,<,q23
q23,1,<,q23
q23, ,<,q14

// все цифры n помечены: идём вправо и возвращаем цифры n (a - 0, b - 1)
// на пробеле после n команды нет - машина останавливается

q14, ,>,q24
q24,a,0,q25
q24,b,1,q25
q25,0,>,q24
q25,1,>,q24
